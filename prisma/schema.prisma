generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @db.VarChar(36)
  email           String  @unique @db.VarChar(254)
  password_hash   String  @db.Text
  name_enc        String  @db.Text
  cpf_enc         String  @db.Text
  cpf_index       String  @unique @db.VarChar(254)
  phone_enc       String  @db.Text
  failed_attempts Int     @default(0)
  locked_until    BigInt?
  token_version   Int     @default(0)
  created_at      BigInt

  addresses       Address[]
  cards           Card[]
  products        Product[]       @relation("SellerProducts")
  purchases       Order[]         @relation("BuyerOrders")
  sales           Order[]         @relation("SellerOrders")
  password_resets PasswordReset[]

  @@map("users")
}

model Address {
  id         String @id @db.VarChar(36)
  user_id    String @db.VarChar(36)
  data_enc   String @db.Text
  created_at BigInt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("addresses")
}

model Card {
  id         String @id @db.VarChar(36)
  user_id    String @db.VarChar(36)
  holder_enc String @db.Text
  pan_enc    String @db.Text
  last4      String @db.Text
  brand      String @db.Text
  exp_month  Int
  exp_year   Int
  created_at BigInt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("cards")
}

model Product {
  id          String @id @db.VarChar(36)
  seller_id   String @db.VarChar(36)
  name        String @db.Text
  description String @db.Text
  price_cents Int
  stock       Int
  active      Int    @default(1)
  created_at  BigInt

  seller User    @relation("SellerProducts", fields: [seller_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders Order[]

  @@map("products")
}

model Order {
  id             String  @id @db.VarChar(36)
  buyer_id       String  @db.VarChar(36)
  seller_id      String  @db.VarChar(36)
  product_id     String  @db.VarChar(36)
  product_name   String  @db.Text
  unit_cents     Int
  quantity       Int
  shipping_cents Int
  total_cents    Int
  address_enc    String  @db.Text
  card_last4     String  @db.Text
  card_brand     String  @db.Text
  status         String  @db.Text
  tracking_code  String? @db.Text
  created_at     BigInt
  updated_at     BigInt

  buyer   User    @relation("BuyerOrders", fields: [buyer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  seller  User    @relation("SellerOrders", fields: [seller_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product Product @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("orders")
}

model PasswordReset {
  id         String  @id @db.VarChar(36)
  user_id    String  @db.VarChar(36)
  token_hash String  @unique @db.VarChar(254)
  expires_at BigInt
  used_at    BigInt?
  created_at BigInt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("password_resets")
}

model AuditLog {
  id         BigInt  @id @default(autoincrement())
  user_id    String? @db.VarChar(36)
  event      String  @db.Text
  ip         String? @db.Text
  detail     String? @db.Text
  created_at BigInt

  @@map("audit_log")
}

model Outbox {
  id         BigInt @id @default(autoincrement())
  to_email   String @db.Text
  subject    String @db.Text
  body       String @db.Text
  created_at BigInt

  @@map("outbox")
}
