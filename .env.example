# Gere um .env com chaves aleatórias usando: npm run setup
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=balcao
DB_USER=balcao
DB_PASSWORD=troque-esta-senha
TRUST_PROXY=false
# Segredos: 32 bytes aleatórios em base64. NUNCA versionar os valores reais.
JWT_SECRET=
DATA_KEY=
CARD_KEY=
INDEX_KEY=
